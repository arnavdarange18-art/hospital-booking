# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).

# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Easiest start: a local SQLite file (created automatically in the instance/ folder).
DATABASE_URL=sqlite:///hospital.db
# MySQL instead (create the database first, see README):
# DATABASE_URL=mysql+pymysql://hospital_user:YOUR_DB_PASSWORD@localhost:3306/hospital

# Set to 1 when the site is served over HTTPS (production).
SESSION_COOKIE_SECURE=0
